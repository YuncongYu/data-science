       "array([[-1.5 ,  1.  ],\n",
       "       [ 1.25, -0.75]])"
      ]
     },
     "execution_count": 6,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "inv(A) @ inv(inv(A) + inv(B)) @ inv(B)"
   ]
  }
