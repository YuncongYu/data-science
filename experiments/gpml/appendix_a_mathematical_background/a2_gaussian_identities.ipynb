   "source": [
    "import numpy as np\n",
    "\n",
    "A = np.array([[1.0, 2.0], [3.0, 4.0]])\n",
    "B = np.array([[5.0, 6.0], [7.0, 8.0]])\n",
    "\n",
    "inv = np.linalg.inv\n",
    "\n",
    "inv(A + B)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "be9103f0ef381cf7",
   "metadata": {},
   "outputs": [
