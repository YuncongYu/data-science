   "source": [
    "import typing\n",
    "\n",
    "\n",
    "def nice_message(name: typing.Optional[str]) -> str:\n",
    "    if name is None:\n",
    "        return \"Hello random person!\"\n",
    "    return f\"Hello, {name}!\"\n",
    "\n",
    "\n",
    "nice_message(1)"
   ]
  }
